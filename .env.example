# Environment mode: development, production, test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*
MORGAN_FORMAT=dev

# Database Configuration (TypeORM / PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastify_db
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_SYNC=true
DB_LOG=false

# Authentication & Session Configuration
JWT_SECRET=your-secure-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_WEB_EXPIRY_DAYS=7
REFRESH_TOKEN_APP_EXPIRY_DAYS=90
DEFAULT_OTP=123456


# Media Storage (S3) & CDN (CloudFront)
# AWS credentials are read from the default AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, profile, or IAM role)
AWS_REGION=us-east-1
S3_BUCKET=backend-fast-media
# S3_ENDPOINT=http://localhost:9000   # S3-compatible endpoint (MinIO/LocalStack) for local dev
# S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
# Optional: serve short-lived signed CloudFront URLs (PEM, \n-escaped newlines allowed)
# CLOUDFRONT_KEY_PAIR_ID=KXXXXXXXXXXXXX
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CDN_URL_TTL_SECONDS=3600
UPLOAD_URL_TTL_SECONDS=600
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES=50
SHARE_BASE_URL=http://localhost:3000/api/v1/shared
