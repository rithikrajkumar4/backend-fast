# Environment mode: development, production, test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*
MORGAN_FORMAT=dev

# Database Configuration (TypeORM / PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastify_db
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_SYNC=true
DB_LOG=false
