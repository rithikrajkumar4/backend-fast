{
  "name": "backend-fast",
  "version": "1.0.0",
  "description": "Fastify TypeScript backend service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:local": "nodemon",
    "dev:prod": "tsx --env-file=.env.prod src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env.local dist/server.js",
    "start:prod": "node --env-file=.env.prod dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fastify",
    "typescript",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/postgres": "^6.1.0",
    "@fastify/sensible": "^6.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
